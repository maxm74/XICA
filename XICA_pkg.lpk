<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="XICA_pkg"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="Massimo Magnano"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="src;src\wia"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)\$(BuildMode)"/>
      </SearchPaths>
      <CodeGeneration>
        <Optimizations>
          <OptimizationLevel Value="0"/>
        </Optimizations>
      </CodeGeneration>
    </CompilerOptions>
    <Description Value="XICA (Cross-platform Image Capture Architecture) for Lazarus (Free Pascal) and Delphi"/>
    <License Value="GPL 3.0"/>
    <Version Release="1"/>
    <Files>
      <Item>
        <Filename Value="src\XICA_PaperSizes.pas"/>
        <UnitName Value="XICA_PaperSizes"/>
      </Item>
      <Item>
        <Filename Value="src\XICA_Types.pas"/>
        <UnitName Value="XICA_Types"/>
      </Item>
      <Item>
        <Filename Value="src\XICA_Classes.pas"/>
        <UnitName Value="XICA_Classes"/>
      </Item>
      <Item>
        <Filename Value="src\XICA.pas"/>
        <UnitName Value="XICA"/>
      </Item>
      <Item>
        <Filename Value="src\wia\XICA_WIA.pas"/>
        <UnitName Value="XICA_WIA"/>
      </Item>
      <Item>
        <Filename Value="src\DelphiCompatibility.pas"/>
        <UnitName Value="DelphiCompatibility"/>
      </Item>
      <Item>
        <Filename Value="src\MM_OpenArrayList.pas"/>
        <UnitName Value="MM_OpenArrayList"/>
      </Item>
    </Files>
    <i18n>
      <EnableI18N Value="True"/>
      <OutDir Value="languages"/>
      <EnableI18NForLFM Value="True"/>
    </i18n>
    <RequiredPkgs>
      <Item>
        <PackageName Value="LazUtils"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
